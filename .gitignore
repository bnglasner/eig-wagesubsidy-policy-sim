# AI tooling: track public agent assets, ignore local-only settings
!.claude/
!.claude/**
!.codex/
!.codex/**
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# R session
.Rhistory
.RData
.Rproj.user/
.Renviron
*.Rproj

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env
*.egg-info/
dist/
build/
.pytest_cache/

# PolicyEngine cache
policyengine_us_cache/
*.h5

# Quarto
.quarto/

# Data boundaries
/data/raw/*
!/data/raw/README.md
/data/processed/*
!/data/processed/README.md

# Output boundaries
/output/data/intermediate_results/*
!/output/data/intermediate_results/README.md
/output/figures/main/*
!/output/figures/main/.gitkeep
/output/figures/appendix/*
!/output/figures/appendix/.gitkeep
/output/tables/main/*
!/output/tables/main/.gitkeep
/output/tables/appendix/*
!/output/tables/appendix/.gitkeep

# Sensitive artifact fallback patterns (defense in depth)
/data/**/*.feather
/data/**/*.fst
/data/**/*.parquet
/data/**/*.rds
/data/**/*.sqlite
/data/**/*.duckdb
/data/**/*.log
/output/data/**/*.feather
/output/data/**/*.fst
/output/data/**/*.parquet
/output/data/**/*.rds
/output/data/**/*.sqlite
/output/data/**/*.duckdb
/output/data/**/*.log

# App data artifacts: tracked for Streamlit Cloud deployment
# These pre-computed parquet files (~7.5 MB total) are included in the repo so
# the app works on Streamlit Cloud without a separate data-download step.
# Negations appear AFTER the catch-all *.parquet rules above to take effect.
!/data/processed/hourly_workers.parquet
!/output/data/intermediate_results/population
!/output/data/intermediate_results/population/*.parquet
!/output/data/intermediate_results/matched_population
!/output/data/intermediate_results/matched_population/*.parquet
!/output/data/intermediate_results/matched_schedules
!/output/data/intermediate_results/matched_schedules/*.parquet
!/output/data/intermediate_results/individual_schedules
!/output/data/intermediate_results/individual_schedules/*.parquet

# Ephemeral agent worktrees (created under .claude/worktrees/ by tooling)
.claude/worktrees/

# Microsoft Office lock/owner temp files
~$*
